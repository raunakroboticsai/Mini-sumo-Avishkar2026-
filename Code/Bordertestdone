const int LEFT_EDGE  = A0;
const int RIGHT_EDGE = A1;

// ================= Motor Pins =================
const int AIN1 = 3;
const int AIN2 = 4;
const int PWMA = 5;

const int BIN1 = 8;
const int BIN2 = 7;
const int PWMB = 6;

const int STBY = 9;
// ==============================================

// Individual thresholds
#define LEFT_EDGE_THRESHOLD   450
#define RIGHT_EDGE_THRESHOLD  400

void motor(int leftSpeed, int rightSpeed)
{
  digitalWrite(STBY, HIGH);

  // Left Motor
  if (leftSpeed >= 0) {
    digitalWrite(AIN1, HIGH);
    digitalWrite(AIN2, LOW);
  } else {
    digitalWrite(AIN1, LOW);
    digitalWrite(AIN2, HIGH);
    leftSpeed = -leftSpeed;
  }

  // Right Motor
  if (rightSpeed >= 0) {
    digitalWrite(BIN1, HIGH);
    digitalWrite(BIN2, LOW);
  } else {
    digitalWrite(BIN1, LOW);
    digitalWrite(BIN2, HIGH);
    rightSpeed = -rightSpeed;
  }

  analogWrite(PWMA, constrain(leftSpeed, 0, 255));
  analogWrite(PWMB, constrain(rightSpeed, 0, 255));
}

void setup()
{
  pinMode(AIN1, OUTPUT);
  pinMode(AIN2, OUTPUT);
  pinMode(PWMA, OUTPUT);

  pinMode(BIN1, OUTPUT);
  pinMode(BIN2, OUTPUT);
  pinMode(PWMB, OUTPUT);

  pinMode(STBY, OUTPUT);
  digitalWrite(STBY, HIGH);
}

void loop()
{
  int leftValue  = analogRead(LEFT_EDGE);
  int rightValue = analogRead(RIGHT_EDGE);

  // White border detected
  if (leftValue < LEFT_EDGE_THRESHOLD || rightValue < RIGHT_EDGE_THRESHOLD)
  {
    motor(-255, -255);    // Full reverse
    delay(250);

    motor(-255, 255);     // Fast turn
    delay(250);
  }
  else
  {
    motor(255, 255);      // Full speed forward
  }
}
